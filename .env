# Database type: mssql, postgres, or mongodb
# DB_TYPE=mssql

# MSSQL connection settings
# DB_HOST=MYHPPC\SQLEXPRESS
# DB_PORT=1433
# DB_NAME=telegram_automation
# DB_INSTANCE=

DB_TYPE=mssql
DB_AUTH_TYPE=sql
DB_HOST=localhost
DB_PORT=1433
DB_INSTANCE=SQLEXPRESS
DB_NAME=telegram_automation
DB_USERNAME=sa
DB_PASSWORD=Ayush@1997

# Optional
NODE_ENV=development
JWT_SECRET=your-secret-key


# Authentication type: 'ntlm' for Windows Authentication, 'sql' for SQL Authentication
# DB_AUTH_TYPE=ntlm

# For NTLM (Windows Authentication), set your domain
DB_DOMAIN=YOURDOMAIN

# For SQL Authentication, uncomment and set these:
# DB_USERNAME=sa
# DB_PASSWORD=yourStrong(!)Password

# JWT secret
JWT_SECRET=your-secret-key

# Node environment
NODE_ENV=development